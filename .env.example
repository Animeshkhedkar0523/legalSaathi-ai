# LegalSaathi Configuration - Copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///legal_saathi.db
# For production: postgresql://user:password@localhost:5432/legal_saathi

# ── API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...  # For LLM integration
GOOGLE_TRANSLATE_API_KEY=  # For translation service
AWS_ACCESS_KEY_ID=  # For S3 storage
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── SMS Gateway ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=  # Twilio SID
TWILIO_AUTH_TOKEN=   # Twilio token
TWILIO_PHONE_NUMBER= # Your Twilio number

# Alternative SMS provider
SMS_GATEWAY_URL=  # E.g., AWS SNS, MSG91, etc.
SMS_GATEWAY_API_KEY=

# ── Application Settings ──────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ENVIRONMENT=development  # development, staging, production

# ── Session Settings ──────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
TOKEN_EXPIRY_DAYS=30
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300

# ── Email Settings (for notifications) ────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@legalsaathi.com

# ── External Services ─────────────────────────────────────────────────────
INDIAN_KANOON_API_URL=https://www.indkanoon.org/
LEGAL_DATABASE_URL=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/legal_saathi.log
